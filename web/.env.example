# All public by nature: they end up in the bundle. Never put a token here.
# Gateway origin, or /api to use the Vite dev proxy (GATEWAY_PROXY=http://127.0.0.1:8080).
VITE_GATEWAY_URL=https://api.raftkv.tushar25.com
# true: never call a gateway, always play public/recording.jsonl.
VITE_REPLAY_ONLY=false
# Link target for "latest report" (docs/CHAOS_RESULTS.md in the repo).
VITE_REPO_URL=https://github.com/MenaceHecker/raftkv
