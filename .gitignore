# Binaries
#
# The leading slash matters: an unanchored "raftkv-server" would also match the
# cmd/raftkv-server source directory and silently keep the entrypoint out of
# the repository.
/bin/
/raftkv-server
/raftkv-bench

# Test artifacts
*.test
*.out
coverage.html

# Runtime data produced by a local cluster
/data/
*.wal
*.snap

# Editor / OS
.DS_Store
.idea/
*.swp

# Dashboard (web/)
web/node_modules
web/dist

# Release output (make release)
/dist/

# Terraform (infra/): state, plans, local backend config and variable files never enter git.
# .terraform.lock.hcl IS committed (provider pins).
*.tfstate
*.tfstate.*
*.tfplan
*.plan
crash.log
*.tfvars
*.tfvars.json
.terraform/
backend.hcl
