            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Apply latency",
      "id": 21,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Time to apply one batch of committed entries. This runs on the same goroutine as consensus, so time spent here is time the node is not replicating or answering heartbeats.",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 18,
        "y": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
