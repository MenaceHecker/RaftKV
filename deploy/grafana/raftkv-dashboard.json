      "title": "Unapplied committed entries",
      "id": 15,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Entries committed but not yet applied. Sustained above zero means the state machine is the bottleneck rather than consensus.",
